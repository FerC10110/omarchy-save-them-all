#!/bin/bash

# restore-them-all: reopen on the active workspace the windows saved by
# save-them-all, rebuild the dwindle tree and restore the geometry.
#
# Usage: restore-them-all [--quiet] [--workspace N]

set -euo pipefail

STATE_DIR="${SAVE_THEM_ALL_STATE:-$HOME/.local/state/save-them-all}"
TIMEOUT="${SAVE_THEM_ALL_TIMEOUT:-25}"
PARKING="special:savethemall"   # hidden workspace where windows wait while the tree is rebuilt
QUIET=0

usage() {
  cat <<USAGE
Usage: restore-them-all [--quiet] [--workspace N]

Reopens the windows saved by save-them-all for the active Hyprland workspace,
rebuilds the dwindle split tree and restores each window's size and position.
Windows that are already open are reused instead of being launched twice.

Options:
  --workspace N   Switch to workspace N first and restore that one.
  --quiet         Do not send a desktop notification.
  -h, --help      Show this help.

Environment:
  SAVE_THEM_ALL_STATE     State directory (default ~/.local/state/save-them-all).
  SAVE_THEM_ALL_TIMEOUT   Seconds to wait for each window (default 25).
USAGE
}

TARGET_WS=""
while (($#)); do
  case "$1" in
    --quiet) QUIET=1; shift ;;
    --workspace)
      [[ ${2:-} =~ ^[0-9]+$ ]] || { echo "restore-them-all: --workspace needs a number" >&2; exit 1; }
      TARGET_WS=$2; shift 2 ;;
    -h | --help) usage; exit 0 ;;
    *) echo "restore-them-all: unknown option: $1" >&2; usage >&2; exit 1 ;;
  esac
done

notify() {
  omarchy-notification-send -g 󱂬 "$1" "${2:-}" >/dev/null 2>&1 || true
}

dispatch() {
  hyprctl dispatch "$1" >/dev/null
}

# The tree is rebuilt by focusing windows, which only works on the workspace
# on screen, so restoring another workspace means going there first.
if [[ -n $TARGET_WS ]]; then
  dispatch "hl.dsp.focus({ workspace = '$TARGET_WS' })"
  for _ in {1..25}; do
    [[ $(hyprctl -j activeworkspace | jq -r '.id') == "$TARGET_WS" ]] && break
    sleep 0.1
  done
fi

ws=$(hyprctl -j activeworkspace | jq -r '.id')
if [[ -n $TARGET_WS && $ws != "$TARGET_WS" ]]; then
  echo "Could not switch to workspace $TARGET_WS" >&2
  exit 1
fi
file="$STATE_DIR/workspace-$ws.json"
if [[ ! -f $file ]]; then
  notify "Nothing saved for workspace $ws" "Run 'Save them all' first"
  echo "No such file: $file" >&2
  exit 1
fi
active_before=$(hyprctl -j activewindow | jq -r '.address // empty')

clients_on_ws() {
  hyprctl -j clients | jq -c --argjson ws "$ws" '[.[] | select(.workspace.id == $ws and .mapped)]'
}

# Chromium's browser window is "chromium" when a launcher starts it and
# "chromium-browser" when it is started some other ways; both are the same app.
addresses_of() { # $1 class -> addresses sorted by position
  clients_on_ws | jq -r --arg c "$1" '
    def family: if . == "chromium-browser" then "chromium" else . end;
    [.[] | select((.class // "" | family) == ($c | family))] | sort_by(.at[0], .at[1]) | .[].address'
}

# The state file is meant to be edited by hand, so nothing read from it is
# trusted. Every window is checked before anything happens: sizes and positions
# end up in Hyprland dispatches and shell arithmetic, so they must be whole
# numbers, and the launcher must be one of the four kinds launch() knows.
# Files saved by version 1.2 or older carry a "cmd" command line instead. The
# Omarchy launchers it could name are read as their kind; any other command
# line counts as no launcher until the workspace is saved again. Prints one
# checked window per line.
read_windows() { # $1 state file
  jq -c '
    def whole: type == "number" and . == floor and . > -1000000 and . < 1000000;
    def pair: type == "array" and length == 2 and all(.[]; whole);
    def legacy:
      (.cmd // "") as $c
      | if $c == "omarchy-launch-browser" then {kind: "browser"}
        elif $c == "omarchy-launch-terminal" then {kind: "terminal"}
        elif $c == "omarchy-launch-terminal herdr" then {kind: "terminal", session: "herdr"}
        elif $c == "omarchy-launch-terminal-tmux" then {kind: "terminal", session: "tmux"}
        elif ($c | test("^omarchy-launch-webapp \"?https?://[^\" ]+\"?$"))
        then {kind: "webapp", url: ($c | capture("(?<u>https?://[^\" ]+)").u | gsub("%%"; "%"))}
        else null end;
    def known:
      . == null or (type == "object" and (
        .kind == "browser"
        or (.kind == "terminal" and (.session == null or .session == "herdr" or .session == "tmux"))
        or (.kind == "webapp" and (.url | type == "string" and test("^https?://[^[:space:][:cntrl:]]+$")))
        or (.kind == "app" and (.desktop | type == "string" and test("^[^/:[:cntrl:]]+\\.desktop$")))));
    def problem:
      if type != "object" then "is not an object"
      elif (.class | type) != "string" or .class == "" then "has no class"
      elif (.at | pair | not) then "at must be two whole numbers"
      elif (.size | pair | not) then "size must be two whole numbers"
      elif ((.floating // false) | type) != "boolean" then "floating must be true or false"
      elif (if has("launch") then .launch else legacy end | known | not) then "launch is not one of browser, terminal, webapp or app"
      else null end;
    if (.windows | type) != "array" then error("has no windows list") else . end
    | .windows | to_entries[]
    | .key as $n | .value
    | problem as $p
    | if $p then error("window \($n + 1)\(if type == "object" and (.class | type) == "string" then " (\(.class))" else "" end) \($p)") else . end
    | {class, launch: (if has("launch") then .launch else legacy end),
       at: (.at | map(floor)), size: (.size | map(floor)), floating: (.floating // false)}
  ' "$1"
}

# Each kind maps to a fixed launcher. The file only picks one and, for a webapp
# or an app, gives it a URL or a desktop entry id, always as a single argument:
# nothing in the file is ever run as a command.
launch() { # $1 launch json
  local kind
  kind=$(jq -r '.kind // "none"' <<<"$1")
  case $kind in
    browser) setsid -f omarchy-launch-browser ;;
    terminal)
      case $(jq -r '.session // ""' <<<"$1") in
        herdr) setsid -f omarchy-launch-terminal herdr ;;
        tmux) setsid -f omarchy-launch-terminal-tmux ;;
        *) setsid -f omarchy-launch-terminal ;;
      esac ;;
    webapp) setsid -f omarchy-launch-webapp "$(jq -r .url <<<"$1")" ;;
    app) setsid -f uwsm-app -- "$(jq -r .desktop <<<"$1")" ;;   # uwsm reads any *.desktop as an entry id
    *) return 1 ;;
  esac >/dev/null 2>&1
}

describe() { # $1 launch json -> "webapp https://…"
  jq -r 'if . == null then "no launcher" else [.kind, (.session // .url // .desktop // empty)] | join(" ") end' <<<"$1"
}

# An app is reopened from its desktop entry, which has to be installed.
app_installed() { # $1 desktop entry id
  local d dirs
  IFS=: read -r -a dirs <<<"${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  for d in "${dirs[@]}"; do
    [[ -n $d && -f $d/applications/$1 ]] && return 0
  done
  return 1
}

is_browser() { # $1 launch json
  jq -e '.kind == "browser" or .kind == "webapp"' <<<"$1" >/dev/null
}

# Any browser or webapp window, on any workspace, means the browser is already up.
browser_running() {
  hyprctl -j clients | jq -e '
    any(.[]; ((.class // "") | test("^(chrome-.*-Default|chromium|chromium-browser|firefox|zen|librewolf)$"))
      or ([.tags[]? | sub("\\*$"; "")] | index("chromium-based-browser") != null))' >/dev/null
}

# Wait for a window of this class whose address was not there before. Prints the address.
wait_new_window() { # $1 class, $2 previous addresses (one per line)
  local deadline=$((SECONDS + TIMEOUT)) a
  while ((SECONDS < deadline)); do
    while IFS= read -r a; do
      [[ -n $a ]] || continue
      grep -qx "$a" <<<"$2" || { echo "$a"; return 0; }
    done < <(addresses_of "$1")
    sleep 0.2
  done
  return 1
}

# Wait until the window count stops changing (Chrome restores its own windows in waves).
wait_settled() {
  local last=-1 n stable=0 deadline=$((SECONDS + 15))
  while ((SECONDS < deadline)); do
    n=$(hyprctl -j clients | jq length)
    if ((n == last)); then ((++stable >= 6)) && return 0; else stable=0; fi
    last=$n
    sleep 0.5
  done
}

dim() { # $1 address, $2 x|y
  local i=0
  [[ $2 == y ]] && i=1
  hyprctl -j clients | jq -r --arg a "$1" --argjson i "$i" '.[] | select(.address == $a) | .size[$i]'
}

# Walk a tiled window's dimension to the target with relative resizes, reading
# back the real size ("exact" resize is not reliable while tiled).
fit() { # $1 address, $2 x|y, $3 target
  local addr=$1 axis=$2 target=$3 cur next delta sign=1 tries=0 dx dy
  cur=$(dim "$addr" "$axis")
  [[ $cur =~ ^[0-9]+$ ]] || return 0
  while ((tries++ < 8)); do
    delta=$((target - cur))
    ((delta > -3 && delta < 3)) && return 0
    dx=0; dy=0
    if [[ $axis == x ]]; then dx=$((delta * sign)); else dy=$((delta * sign)); fi
    dispatch "hl.dsp.window.resize({ window = 'address:$addr', x = $dx, y = $dy, relative = true })"
    sleep 0.15
    next=$(dim "$addr" "$axis")
    if ((next == cur)); then
      sign=$((-sign))          # no effect: try the other direction
      ((tries > 2)) && return 0
      continue
    fi
    (((next - cur) * delta < 0)) && sign=$((-sign))   # moved away: flip
    cur=$next
  done
}

place_floating() { # $1 address, $2 w, $3 h, $4 x, $5 y  (verified order: float, resize, move)
  dispatch "hl.dsp.window.float({ window = 'address:$1', state = 'on' })"
  sleep 0.1
  dispatch "hl.dsp.window.resize({ window = 'address:$1', x = $2, y = $3, exact = true })"
  sleep 0.1
  dispatch "hl.dsp.window.move({ window = 'address:$1', x = $4, y = $5, exact = true })"
}

park() { # $1 address -> to the hidden workspace
  dispatch "hl.dsp.window.move({ window = 'address:$1', workspace = '$PARKING', follow = false })"
}

# Put a window back on the workspace. With $2/$3 it lands next to another window ($3 = r|d).
unpark() { # $1 address, [$2 neighbour address, $3 side]
  if [[ -n ${2:-} ]]; then
    dispatch "hl.dsp.focus({ window = 'address:$2' })"
    dispatch "hl.dsp.layout('preselect $3')"
  fi
  dispatch "hl.dsp.window.move({ window = 'address:$1', workspace = '$ws', follow = false })"
  sleep 0.25
}

# Derive the guillotine split tree from the saved rectangles and return the
# insertion plan: the seed window first, then each window next to one already placed.
# A vertical cut (line x=c) leaves windows side by side -> preselect r;
# a horizontal cut (line y=c) leaves them stacked -> preselect d.
build_plan() { # $1: [{i, x, y, w, h}]
  python3 - "$1" <<'PY'
import json, sys
rects = json.loads(sys.argv[1])

def split(rs):
    if len(rs) == 1:
        return ("leaf", rs[0]["i"])
    for c in sorted({r["x"] + r["w"] for r in rs}):
        left = [r for r in rs if r["x"] + r["w"] <= c]
        right = [r for r in rs if r["x"] >= c]
        if left and right and len(left) + len(right) == len(rs):
            return ("r", split(left), split(right))
    for c in sorted({r["y"] + r["h"] for r in rs}):
        top = [r for r in rs if r["y"] + r["h"] <= c]
        bottom = [r for r in rs if r["y"] >= c]
        if top and bottom and len(top) + len(bottom) == len(rs):
            return ("d", split(top), split(bottom))
    return ("r", ("leaf", rs[0]["i"]), split(rs[1:]))   # no clean cut: chain them

def seed(n):
    return n[1] if n[0] == "leaf" else seed(n[1])

steps = []
def realize(n):
    if n[0] == "leaf":
        return
    steps.append({"op": "insert", "i": seed(n[2]), "next_to": seed(n[1]), "dir": n[0]})
    realize(n[1])
    realize(n[2])

root = split(rects)
steps.append({"op": "seed", "i": seed(root)})
realize(root)
print(json.dumps(steps))
PY
}

# ---------- 1. Open whatever is missing ----------
if ! windows=$(read_windows "$file" 2>&1); then
  problem=${windows##*$'\n'}   # the windows checked before it come first
  problem=${problem#jq: }
  problem=${problem#error (at *): }
  notify "Cannot restore workspace $ws" "$(basename "$file"): $problem"
  echo "restore-them-all: $file: $problem" >&2
  exit 1
fi
entries=()
[[ -z $windows ]] || mapfile -t entries <<<"$windows"

# A browser starting cold restores its own last session, and those windows
# arrive in waves. Counting what is missing before it finishes would launch
# windows it was about to bring back, so start it first, let it settle, and
# only then count. The browser window is preferred for the first launch: a
# plain start restores the session instead of adding a window to it.
if ! browser_running; then
  first=""
  for e in "${entries[@]}"; do
    l=$(jq -c .launch <<<"$e")
    is_browser "$l" || continue
    [[ $(jq -r .kind <<<"$l") == browser ]] && { first=$l; break; }
    [[ -z $first ]] && first=$l
  done
  if [[ -n $first ]]; then
    echo "starting the browser: $(describe "$first")"
    launch "$first"
    for _ in $(seq $((TIMEOUT * 5))); do
      browser_running && break
      sleep 0.2
    done
    wait_settled
  fi
fi
declare -A used=()
declare -a addrs=()
opened=0
skipped=0
missing=()

for i in "${!entries[@]}"; do
  e=${entries[$i]}
  cls=$(jq -r .class <<<"$e")
  l=$(jq -c .launch <<<"$e")
  need=$(( ${used[$cls]:-0} + 1 ))
  mapfile -t existing < <(addresses_of "$cls")
  if ((${#existing[@]} >= need)); then
    addrs[$i]=${existing[$((need - 1))]}
    used[$cls]=$need
    ((++skipped))
    echo "already open: $cls"
    continue
  fi
  if [[ $l == null ]]; then
    echo "no launcher: $cls" >&2
    missing+=("$cls (no launcher)")
    continue
  fi
  if [[ $(jq -r .kind <<<"$l") == app ]] && ! app_installed "$(jq -r .desktop <<<"$l")"; then
    echo "not installed: $(describe "$l")" >&2
    missing+=("$cls (not installed)")
    continue
  fi
  before=$(printf '%s\n' "${existing[@]}")
  echo "opening: $cls  ($(describe "$l"))"
  launch "$l"
  if addr=$(wait_new_window "$cls" "$before"); then
    sleep 1   # grace period: an app that fails to start maps a window and closes it right away
    if ! addresses_of "$cls" | grep -qx "$addr"; then
      echo "closed itself: $cls" >&2
      missing+=("$cls (closed itself)")
      continue
    fi
    addrs[$i]=$addr
    used[$cls]=$need
    ((++opened))
    is_browser "$l" && wait_settled
  else
    echo "never appeared: $cls" >&2
    missing+=("$cls")
  fi
done

# ---------- 2. Rebuild the dwindle tree ----------
tiled='[]'
for i in "${!entries[@]}"; do
  [[ -n ${addrs[$i]:-} ]] || continue
  [[ $(jq -r .floating <<<"${entries[$i]}") == true ]] && continue
  tiled=$(jq -c --argjson i "$i" --argjson e "${entries[$i]}" \
    '. + [{i: $i, x: $e.at[0], y: $e.at[1], w: $e.size[0], h: $e.size[1]}]' <<<"$tiled")
done

if (( $(jq length <<<"$tiled") > 1 )); then
  plan=$(build_plan "$tiled")
  managed=$(printf '%s\n' "${addrs[@]}")
  extras=()
  # Park every tiled window on the workspace, including the ones that were not saved.
  while IFS=$'\t' read -r a fl; do
    [[ $fl == true ]] && continue
    grep -qx "$a" <<<"$managed" || extras+=("$a")
    park "$a"
  done < <(clients_on_ws | jq -r '.[] | [.address, (.floating|tostring)] | @tsv')
  sleep 0.3
  last=""
  while IFS= read -r step; do
    i=$(jq -r .i <<<"$step")
    if [[ $(jq -r .op <<<"$step") == insert ]]; then
      unpark "${addrs[$i]}" "${addrs[$(jq -r .next_to <<<"$step")]}" "$(jq -r .dir <<<"$step")"
    else
      unpark "${addrs[$i]}"
    fi
    last=${addrs[$i]}
  done < <(jq -c '.[]' <<<"$plan")
  for a in "${extras[@]}"; do   # unsaved windows come back last, to the right of the last one
    unpark "$a" "$last" r
    last=$a
  done
fi

# ---------- 3. Geometry ----------
for i in "${!entries[@]}"; do
  [[ -n ${addrs[$i]:-} ]] || continue
  read -r fl w h x y < <(jq -r '"\(.floating) \(.size[0]) \(.size[1]) \(.at[0]) \(.at[1])"' <<<"${entries[$i]}")
  if [[ $fl == true ]]; then
    place_floating "${addrs[$i]}" "$w" "$h" "$x" "$y"
  else
    fit "${addrs[$i]}" x "$w"
    fit "${addrs[$i]}" y "$h"
  fi
done

# Give focus back to where it was, if that window is still on the workspace.
if [[ -n $active_before ]] && clients_on_ws | jq -e --arg a "$active_before" 'any(.[]; .address == $a)' >/dev/null; then
  dispatch "hl.dsp.focus({ window = 'address:$active_before' })"
fi

summary="$opened opened, $skipped already there"
if ((${#missing[@]})); then
  notify "Windows: ${#missing[@]} missing" "$(printf '%s, ' "${missing[@]}" | sed 's/, $//')"
  echo "$summary; missing: ${missing[*]}" >&2
  exit 1
fi
echo "$summary"
((QUIET)) || notify "Windows restored on workspace $ws" "$summary"
