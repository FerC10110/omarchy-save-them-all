#!/bin/bash

# save-them-all: save the windows of the active workspace (order, how to
# reopen each one and geometry) so restore-them-all can bring them back later.
#
# Usage: save-them-all [--quiet]
# State: ~/.local/state/save-them-all/workspace-<id>.json (hand-editable)

set -euo pipefail

BIN_DIR=$(dirname "$(readlink -f "$0")")
# shellcheck source=lib/i18n.sh
source "$BIN_DIR/lib/i18n.sh"

STATE_DIR="${SAVE_THEM_ALL_STATE:-$HOME/.local/state/save-them-all}"
IFS=: read -r -a DATA_DIRS <<<"${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
APPS_DIRS=("${DATA_DIRS[@]/%//applications}")
EXCLUDE_CLASSES='^(org\.omarchy\.screensaver|)$'
QUIET=0

usage() {
  cat <<USAGE
Usage: save-them-all [--quiet]

Saves every window of the active Hyprland workspace: its launch command, its
position and its size. Restore them later with restore-them-all.

Options:
  --quiet      Do not send a desktop notification.
  -h, --help   Show this help.

Environment:
  SAVE_THEM_ALL_STATE   State directory (default ~/.local/state/save-them-all).
USAGE
}

case "${1:-}" in
  --quiet) QUIET=1 ;;
  -h | --help) usage; exit 0 ;;
  "") ;;
  *) echo "save-them-all: unknown option: $1" >&2; usage >&2; exit 1 ;;
esac

notify() {
  omarchy-notification-send -g 󱂬 "$1" "${2:-}" >/dev/null 2>&1 || true
}

has_tag() { # $1 window json, $2 tag (without the trailing *)
  jq -e --arg t "$2" '[.tags[]? | sub("\\*$"; "")] | index($t) != null' <<<"$1" >/dev/null
}

# https://host/path?x -> chrome-host__path-Default (how Chromium names webapps)
url_class() {
  local u=${1#*://} host path=""
  u=${u%%\?*}
  u=${u%%#*}
  host=${u%%/*}
  [[ $u == */* ]] && path=${u#*/}
  printf 'chrome-%s__%s-Default' "$host" "${path//\//_}"
}

# The URL of the .desktop file that produces this class; failing that, the
# URL rebuilt out of the class itself.
webapp_url() { # $1 class
  local cls=$1 d f exec_line url body host path
  for d in "${APPS_DIRS[@]}"; do for f in "$d"/*.desktop; do
    [[ -f $f ]] || continue
    exec_line=$(grep -m1 '^Exec=omarchy-launch-webapp' "$f" 2>/dev/null) || continue
    url=$(sed -E 's/^Exec=omarchy-launch-webapp +"?([^" ]+)"?.*$/\1/' <<<"$exec_line")
    if [[ $(url_class "$url") == "$cls" ]]; then
      printf '%s' "${url//%%/%}"   # an Exec line writes a literal % as %%
      return 0
    fi
  done; done
  body=${cls#chrome-}
  body=${body%-Default}
  host=${body%%__*}
  path=${body#*__}
  printf 'https://%s/%s' "$host" "${path//_/\/}"
}

terminal_launch() { # $1 pid
  local tree
  tree=$(pstree -A "$1" 2>/dev/null || true)
  if grep -q 'herdr' <<<"$tree"; then
    echo '{"kind":"terminal","session":"herdr"}'
  elif grep -q 'tmux' <<<"$tree"; then
    echo '{"kind":"terminal","session":"tmux"}'
  else
    echo '{"kind":"terminal"}'
  fi
}

# The installed desktop entry a window belongs to, matched the way docks and
# launchers match windows to apps: by StartupWMClass, then by an entry id equal
# to the class, then by the program its Exec line runs, if only one entry runs
# it. Prints the entry id, or nothing.
desktop_entry() { # $1 class, $2 pid
  python3 - "$1" "$2" "${APPS_DIRS[@]}" <<'PY'
import os, shlex, sys

cls, pid, dirs = sys.argv[1].lower(), sys.argv[2], sys.argv[3:]

def fields(path):
    out, section = {}, None
    with open(path, encoding="utf-8", errors="replace") as f:
        for line in f:
            line = line.strip()
            if line.startswith("["):
                section = line
            elif section == "[Desktop Entry]" and "=" in line:
                key, value = line.split("=", 1)
                out.setdefault(key.strip(), value.strip())
    return out

def program(exec_line):
    try:
        argv = shlex.split(exec_line)
    except ValueError:
        argv = exec_line.split()
    while argv and (argv[0] == "env" or "=" in argv[0]):   # env FOO=bar program
        argv = argv[1:]
    return os.path.basename(argv[0]) if argv else ""

# What the window's process goes by: its executable and its argv[0].
names = set()
try:
    names.add(os.path.basename(os.readlink(f"/proc/{pid}/exe")))
except OSError:
    pass
try:
    with open(f"/proc/{pid}/cmdline", "rb") as f:
        names.add(os.path.basename(f.read().split(b"\0")[0].decode(errors="replace").split(" ")[0]))
except OSError:
    pass
names.discard("")

entries = {}   # id -> fields; the first directory holding an id wins, as for any launcher
for d in dirs:
    try:
        listing = sorted(os.listdir(d))
    except OSError:
        continue
    for name in listing:
        if not name.endswith(".desktop") or ":" in name or name in entries:
            continue
        try:
            entries[name] = fields(os.path.join(d, name))
        except OSError:
            pass

by_class, by_id, by_program = [], [], []
for eid, e in entries.items():
    if e.get("Type", "Application") != "Application" or e.get("Hidden") == "true" or not e.get("Exec"):
        continue
    if e.get("StartupWMClass", "").lower() == cls:
        by_class.append(eid)
    elif eid.removesuffix(".desktop").lower() == cls:
        by_id.append(eid)
    elif program(e["Exec"]) in names:
        by_program.append(eid)

def preferred(ids):   # entries a launcher shows come before hidden helpers
    return [i for i in ids if entries[i].get("NoDisplay") != "true"] or ids

program_match = preferred(by_program)
pick = (preferred(by_class) or preferred(by_id) or [None])[0] \
    or (program_match[0] if len(program_match) == 1 else None)
if pick:
    print(pick)
PY
}

# How a window comes back. The state file names one of four kinds of launcher
# and never a command: restore-them-all maps each kind to a fixed launcher, so
# editing the file, by hand or otherwise, cannot make it run anything else.
launch_of() { # $1 window json -> launch json, or null when nothing can reopen it
  local w=$1 cls pid id
  cls=$(jq -r .class <<<"$w")
  pid=$(jq -r .pid <<<"$w")
  if [[ $cls == chrome-*-Default ]]; then
    jq -nc --arg u "$(webapp_url "$cls")" '{kind: "webapp", url: $u}'
  elif has_tag "$w" chromium-based-browser || [[ $cls =~ ^(firefox|zen|librewolf)$ ]]; then
    echo '{"kind":"browser"}'
  elif has_tag "$w" terminal; then
    terminal_launch "$pid"
  elif id=$(desktop_entry "$cls" "$pid") && [[ -n $id ]]; then
    jq -nc --arg d "$id" '{kind: "app", desktop: $d}'
  else
    echo null
  fi
}

ws=$(hyprctl -j activeworkspace | jq -r '.id')
monitor=$(hyprctl -j activeworkspace | jq -r '.monitor')
out="$STATE_DIR/workspace-$ws.json"

# A card hides the windows of its other side, and those are saved too: with
# Hyprflip loaded, the members of the workspace's live cards; without it, the
# hidden windows of native groups whose class and launcher belonged to a card
# saved before.
status=$("$BIN_DIR/cards" status --workspace "$ws" --previous "$out" 2>/dev/null) || status='{}'
flip=$(jq -r '.available == true' <<<"$status" 2>/dev/null || echo false)
reason=$(jq -r '.reason // ""' <<<"$status" 2>/dev/null || echo '')
if [[ $flip == true ]]; then
  members=$("$BIN_DIR/cards" members --workspace "$ws" 2>/dev/null) || members='[]'
else
  members=$("$BIN_DIR/cards" members --workspace "$ws" --previous "$out" 2>/dev/null) || members='[]'
fi

# Without Hyprflip (not loaded, or loaded but not answering: `cards members`
# then reads the previous file), those hidden windows matched by class; their
# launcher must match too, when the previous save kept one: the card's
# windows as they were saved, as [{class, launch, known}]. With Hyprflip
# loaded but its helper unusable, members are its live cards': no filter.
card_keys=null
if [[ ($reason == no-plugin || $reason == mismatch) && $members != '[]' ]]; then
  card_keys=$(jq -c '.windows as $w | [.cards[]?.faces[]?.windows[]? | $w[.]? | select(type == "object")
    | {class, launch, known: has("launch")}]' "$out" 2>/dev/null) || card_keys=null
fi

# Order = left to right, top to bottom: this is what reproduces the dwindle tree.
# A card's windows share one place: there the shown one comes first, the same
# tie-break restore-them-all makes, since Hyprland's own listing order changes.
clients=$(hyprctl -j clients | jq -c --argjson ws "$ws" --arg ex "$EXCLUDE_CLASSES" --argjson members "$members" '
  [.[] | select(.workspace.id == $ws and .mapped
                and (((.hidden // false) | not) or (.address as $a | $members | index($a) != null))
                and ((.class // "") | test($ex) | not))]
  | sort_by(.at[0], .at[1], (.hidden // false)) | .[]')

entries='[]'
addresses='[]'
lines=()
while IFS= read -r w; do
  [[ -n $w ]] || continue
  cls=$(jq -r .class <<<"$w")
  launch=$(launch_of "$w")
  if [[ $card_keys != null && $(jq -r '.hidden // false' <<<"$w") == true ]] &&
     ! jq -e --arg c "$cls" --argjson l "$launch" \
       'any(.[]; .class == $c and ((.known | not) or .launch == $l))' <<<"$card_keys" >/dev/null; then
    continue
  fi
  [[ $launch != null ]] || echo "no desktop entry for $cls: restoring arranges it when open, but cannot reopen it" >&2
  entry=$(jq -c --argjson l "$launch" '{class, title: (.title // ""), launch: $l, at, size, floating}' <<<"$w")
  entries=$(jq -c --argjson e "$entry" '. + [$e]' <<<"$entries")
  addresses=$(jq -c --arg a "$(jq -r .address <<<"$w")" '. + [$a]' <<<"$addresses")
  lines+=("$(jq -r '"\(.size[0])x\(.size[1]) @\(.at[0]),\(.at[1])  \(.class)  ->  \(
    .launch | if . == null then "not reopened" else [.kind, (.session // .url // .desktop // empty)] | join(" ") end)"' <<<"$entry")")
done <<<"$clients"

n=$(jq length <<<"$entries")
if ((n == 0)); then
  notify "$(msg "Nothing to save")" "$(msg "No windows on workspace %1" "$ws")"
  msg "No windows on workspace %1" "$ws" >&2
  exit 1
fi

# The cards: asked to Hyprflip, or kept from the previous save when Hyprflip
# is not there to ask. bin/cards prints {cards, notes}; preserve adds {warnings}.
# A previous file that cannot be read is a warning: shown when notifying
# anyway, never a reason to notify a --quiet save (1.3 was silent there).
none='{"cards":[],"notes":[]}'
result=$none
if [[ $flip == true ]]; then
  if ! result=$("$BIN_DIR/cards" capture --workspace "$ws" --addresses "$addresses" 2>/dev/null); then
    result=$("$BIN_DIR/cards" preserve --previous "$out" --windows "$entries" 2>/dev/null) || result=$none
    # Only news when there was something to keep.
    result=$(jq -c --arg n "$(msg "Hyprflip did not answer; the cards saved before were kept")" \
      'if (.cards | length) > 0 then .notes += [$n] else . end' <<<"$result")
  fi
elif [[ -f $out ]]; then
  result=$("$BIN_DIR/cards" preserve --previous "$out" --windows "$entries" 2>/dev/null) || result=$none
fi
cards=$(jq -c '.cards' <<<"$result")
notes=$(jq -r '.notes[]' <<<"$result")
warnings=$(jq -r '.warnings[]?' <<<"$result")
k=$(jq length <<<"$cards")

mkdir -p "$STATE_DIR"
# Saving again replaces the windows, not the choice to restore them at login.
autostart=$(jq -r 'if .autostart == true then "true" else "false" end' "$out" 2>/dev/null || echo false)
tmp=$(mktemp "$STATE_DIR/.save.XXXXXX")
jq -n --argjson ws "$ws" --arg monitor "$monitor" --arg saved_at "$(date -Is)" \
  --argjson autostart "$autostart" --argjson windows "$entries" --argjson cards "$cards" \
  '{workspace: $ws, monitor: $monitor, saved_at: $saved_at, autostart: $autostart, windows: $windows}
   + (if ($cards | length) > 0 then {cards: $cards} else {} end)' >"$tmp"
mv "$tmp" "$out"

printf '%s\n' "${lines[@]}"
echo "Saved: $out"
if ((k == 0)); then
  title=$(msg "Saved %1 windows from workspace %2" "$n" "$ws")
elif ((k == 1)); then
  title=$(msg "Saved %1 windows and 1 card from workspace %2" "$n" "$ws")
else
  title=$(msg "Saved %1 windows and %2 cards from workspace %3" "$n" "$k" "$ws")
fi
body=$(printf '%s\n' "${lines[@]}" | awk '{print $3}' | paste -sd ', ')
[[ -z $notes ]] || echo "$notes" >&2
[[ -z $warnings ]] || echo "$warnings" >&2
news=$(printf '%s\n%s' "$notes" "$warnings" | sed '/^$/d')
# A card left out is news even when the panel asked for quiet.
if ((!QUIET)) || [[ -n $notes ]]; then
  notify "$title" "$body${news:+$'\n'$news}"
fi
